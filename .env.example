# =============================================================================
# POSTADOR — Variáveis de Ambiente
# Copie para .env e preencha com suas credenciais reais
# NUNCA commite o .env com segredos reais
# =============================================================================

# --- DATABASE ---
DATABASE_URL="postgresql://postador:senha@localhost:5432/postador_db"
DATABASE_DIRECT_URL="postgresql://postador:senha@localhost:5432/postador_db"

# --- REDIS ---
REDIS_URL="redis://localhost:6379"

# --- AUTH (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# Providers OAuth (opcional para uso pessoal)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI PROVIDERS ---
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""

# AI Gateway Config
AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL="gpt-4o"
AI_FALLBACK_PROVIDER="anthropic"
AI_FALLBACK_MODEL="claude-3-5-sonnet-20241022"
AI_MAX_TOKENS_DEFAULT=4096
AI_TEMPERATURE_DEFAULT=0.7

# --- S3 STORAGE ---
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="us-east-1"
S3_BUCKET_NAME="postador-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="https://postador-assets.s3.amazonaws.com"

# --- INSTAGRAM / META ---
# Use apenas Graph API oficial
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# --- REMOTION ---
REMOTION_API_URL="http://localhost:3001"
REMOTION_API_KEY=""
REMOTION_CONCURRENCY=4
REMOTION_OUTPUT_BUCKET="postador-renders"

# --- TREND REPOSITORY ---
# Adapter para o repositório de tendências externo
TRENDS_REPO_URL="http://localhost:4000"
TRENDS_REPO_API_KEY=""
TRENDS_SYNC_INTERVAL_MINUTES=60

# --- AVATAR/VOICE REPOSITORY ---
AVATAR_REPO_URL="http://localhost:4001"
AVATAR_REPO_API_KEY=""
VOICE_CLONE_API_KEY=""

# --- APP CONFIG ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"
LOG_LEVEL="debug"
ENABLE_AUDIT_LOG=true

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- WORKER ---
WORKER_CONCURRENCY=5
JOB_RETENTION_HOURS=168

# --- OBSERVABILITY ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
